# ============================================================
# 企业级 Python 平台环境变量配置模板
# ------------------------------------------------------------
# 使用说明：
#   1. 复制本文件为 .env：  cp .env-example .env
#   2. 根据实际环境修改以下占位值为真实配置
#   3. 请勿将包含真实密钥的 .env 文件提交到版本控制
#   4. SECRET_KEY 生产环境请使用：openssl rand -hex 32
# ============================================================

# ---------- 应用配置 ----------
APP_NAME=Python Enterprise Platform
DEBUG=False
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# ---------- 数据库配置 ----------
# 本地开发用完整连接 URL
DATABASE_URL=mysql+aiomysql://root:your_password@localhost:3306/enterprise_db
# 数据库组件变量（Docker 部署时被 docker-compose 引用）
MYSQL_ROOT_PASSWORD=your_password
MYSQL_DATABASE=enterprise_db
MYSQL_USER=app_user
MYSQL_PASSWORD=your_password
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# ---------- Redis 配置 ----------
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=enterprise:

# ---------- 安全配置 ----------
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- Celery 配置 ----------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TIMEZONE=Asia/Shanghai

# ---------- 限流配置 ----------
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_ENABLED=True

# ---------- CORS 配置 ----------
# 多个来源用英文逗号分隔，如：https://a.com,https://b.com
CORS_ORIGINS=*

# ---------- 日志配置 ----------
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ---------- 管理员配置（数据库初始化脚本使用） ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production
ADMIN_EMAIL=admin@example.com
